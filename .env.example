# ============================================================
# nilgiriContest — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# -------------------------------------------------
# Supabase (required for ALL environments)
# Find these in: Supabase Dashboard > Project Settings > API
# -------------------------------------------------

# Project URL (e.g. https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Publishable / anon key — safe to expose to the browser
SUPABASE_PUBLISHABLE_KEY=

# Service-role secret key — server-side only, KEEP PRIVATE
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------
# Coding judge — optional, enables the "Run tests" feature
# Self-host Judge0 (https://github.com/judge0/judge0) or use
# a hosted Judge0 instance.
# -------------------------------------------------

# Judge0 base URL (e.g. http://localhost:2358)
# JUDGE0_URL=

# Judge0 authentication token (if your instance requires one)
# JUDGE0_AUTH_TOKEN=

# -------------------------------------------------
# Cron job authentication — optional
# Set this to a long random secret when using scheduled
# Supabase Edge Functions or external cron runners.
# -------------------------------------------------

# CRON_SECRET=
# CRON_SECRET_PREVIOUS=
